# ContainedCode Environment Configuration
# Copy this file to .env and fill in your values

# === Agent (default: Pi coding agent) ===
# Command to run in tmux (default: pi). Set to "codex", "amp", etc.
# AGENT_CMD=pi

# Extra arguments for the agent (e.g. for Pi: --auto-next-steps)
# AGENT_ARGS=

# Path to agent config directory (default: ~/.pi)
# AGENT_CONFIG_DIR=~/.pi

# === Pi-specific (legacy, use AGENT_CMD/AGENT_ARGS instead) ===
# PI_COMMAND=pi
# PI_ARGS=--auto-next-steps
# PI_CONFIG_DIR=~/.pi

# === SSH Access ===
# SSH port on the host (default: 2222)
# SSH_PORT=2222

# Path to your SSH authorized_keys file (for remote access)
# SSH_AUTHORIZED_KEYS=~/.ssh/authorized_keys

# === Web IDE Server ===
# Password for the web IDE server. When set, the server auto-starts.
# WEB_SERVER_PASSWORD=your-secure-password-here

# Force enable/disable web server. When unset, auto-enables if password is set.
# Set to "false" to disable even with a password.
# WEB_SERVER_ENABLED=

# Web server port (default: 8888)
# PORT=8888

# Path to web IDE config directory
# WEB_CONFIG_DIR=~/.config/opencode

# === General ===
# Disable auto-update on container start (default: true)
# AUTO_UPDATE=false
