# OpenCode Server Environment Configuration
# Copy this file to .env and fill in your values

# === Pi Coding Agent ===
# Command to run Pi (default: pi)
# PI_COMMAND=pi

# Extra arguments for Pi (e.g. for autonomous mode with pi-infinity)
# PI_ARGS=--auto-next-steps

# Path to Pi config directory (extensions, skills, sessions)
# PI_CONFIG_DIR=~/.pi

# === SSH Access ===
# SSH port on the host (default: 2222)
# SSH_PORT=2222

# Path to your SSH authorized_keys file (for remote access)
# SSH_AUTHORIZED_KEYS=~/.ssh/authorized_keys

# === OpenCode Web Server (optional) ===
# Enable the OpenCode web server alongside Pi (default: false)
# OPENCODE_SERVER_ENABLED=false

# Password for OpenCode web server authentication (required if enabled)
# OPENCODE_SERVER_PASSWORD=your-secure-password-here

# OpenCode web server port (default: 8888)
# PORT=8888

# Path to OpenCode config directory
# OPENCODE_CONFIG_DIR=~/.config/opencode

# === General ===
# Disable auto-update on container start (default: true)
# OPENCODE_AUTO_UPDATE=false
