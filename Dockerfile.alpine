# Dockerfile for building OpenCode server without Nix
# This is a fallback for systems without Nix installed
#
# Build: docker build -f Dockerfile.alpine -t opencode-server .

FROM alpine:3.21

# Install essential packages (gcompat for glibc compatibility on Alpine)
RUN apk add --no-cache \
    bash \
    coreutils \
    sudo \
    shadow \
    curl \
    wget \
    git \
    make \
    cmake \
    gcc \
    g++ \
    pkgconfig \
    nodejs \
    npm \
    python3 \
    py3-pip \
    go \
    rust \
    cargo \
    postgresql-client \
    redis \
    sqlite \
    jq \
    yq \
    nano \
    vim \
    htop \
    procps \
    grep \
    sed \
    gawk \
    findutils \
    ca-certificates \
    xz \
    gcompat \
    tmux \
    openssh-server \
    && rm -rf /var/cache/apk/*

# Install Nix package manager (optional — may fail on QEMU-emulated builds
# where seccomp BPF isn't supported. Users can install Nix at runtime.)
RUN addgroup -g 30000 -S nixbld 2>/dev/null; \
    for i in $(seq 1 30); do adduser -S -D -h /var/empty -g "Nix build user $i" -u $((30000 + i)) -G nixbld nixbld$i 2>/dev/null; done; \
    mkdir -p /etc/nix /nix && \
    echo 'sandbox = false' > /etc/nix/nix.conf && \
    echo 'experimental-features = nix-command flakes' >> /etc/nix/nix.conf && \
    echo 'trusted-users = root opencode' >> /etc/nix/nix.conf && \
    echo 'build-users-group = nixbld' >> /etc/nix/nix.conf && \
    (NIX_CONF_DIR=/etc/nix sh <(curl -L https://nixos.org/nix/install) --no-daemon --no-build-users 2>/dev/null || echo "Nix install skipped") && \
    if [ -f /nix/var/nix/profiles/default/etc/profile.d/nix.sh ]; then \
        mkdir -p /etc/profile.d && \
        ln -sf /nix/var/nix/profiles/default/etc/profile.d/nix.sh /etc/profile.d/nix.sh; \
    fi

# Create non-root user
RUN adduser -D -u 1000 -h /home/opencode -s /bin/bash opencode

# Install bun as opencode user
USER opencode
ENV HOME=/home/opencode
ENV BUN_INSTALL=/home/opencode/.bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/home/opencode/.bun/bin:$PATH"

# Install uv (Python package manager) as opencode user
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Install OpenCode via bun (detect arch and install correct musl variant)
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
        x86_64) MUSL_PKG="opencode-linux-x64-musl" ;; \
        aarch64) MUSL_PKG="opencode-linux-arm64-musl" ;; \
        *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
    esac && \
    bun install -g opencode-ai "$MUSL_PKG" && \
    ln -sf "/home/opencode/.bun/install/global/node_modules/$MUSL_PKG/bin/opencode" \
           "/home/opencode/.bun/install/global/node_modules/opencode-ai/bin/.opencode"

# Install Pi coding agent
RUN bun install -g @earendil-works/pi-coding-agent

# Install Codex CLI
RUN CODEX_NON_INTERACTIVE=true curl -fsSL https://chatgpt.com/codex/install.sh | sh

# Install Amp (binary is on disk, but requires glibc — does not work on Alpine's musl without full glibc compat)
RUN curl -fsSL https://ampcode.com/install.sh | bash

# Symlink agent binaries into system PATH so they're found even in su - login shells
USER root
RUN ln -sf /home/opencode/.local/bin/codex /usr/bin/codex && \
    ln -sf /home/opencode/.local/bin/amp /usr/bin/amp 2>/dev/null || true && \
    ln -sf /home/opencode/.bun/bin/pi /usr/bin/pi && \
    ln -sf /home/opencode/.bun/bin/bun /usr/bin/bun && \
    ln -sf /home/opencode/.bun/bin/opencode /usr/bin/opencode
USER opencode

# Install language servers globally for LSP support
RUN bun install -g typescript-language-server typescript vscode-langservers-extracted pyright yaml-language-server bash-language-server dockerfile-language-server-nodejs @biomejs/biome @vtsls/language-server

# Switch back to root for setup
USER root

# Create necessary directories with correct ownership
RUN install -d -o opencode -g opencode /workspace \
    /home/opencode/.config/opencode \
    /home/opencode/.local/state \
    /home/opencode/.cache \
    /home/opencode/.pi \
    /home/opencode/.ssh \
    /home/opencode/.npm-global \
    /nix/var/nix/profiles/per-user/opencode && \
    chown opencode:nixbld /nix/var/nix/profiles/per-user/opencode

# ast-grep not included — the pre-built binary requires glibc symbols
# (gnu_get_libc_version) not available on Alpine even with gcompat.
# Install at runtime if needed: nix profile install nixpkgs#ast-grep
RUN echo "ast-grep omitted (glibc dep, install via nix at runtime)"

# Stage build-time content for volume initialization
RUN mkdir -p /opt/init-nix /opt/init-local /opt/init-cache && \
    cp -a /nix/. /opt/init-nix/ && \
    cp -a /home/opencode/.local/. /opt/init-local/ && \
    cp -a /home/opencode/.cache/. /opt/init-cache/ 2>/dev/null || true

# Configure SSH server
RUN ssh-keygen -A && \
    mkdir -p /run/sshd && \
    echo "AllowUsers opencode" >> /etc/ssh/sshd_config && \
    echo "PasswordAuthentication no" >> /etc/ssh/sshd_config && \
    echo "PubkeyAuthentication yes" >> /etc/ssh/sshd_config && \
    echo "PermitRootLogin no" >> /etc/ssh/sshd_config && \
    echo "ClientAliveInterval 60" >> /etc/ssh/sshd_config && \
    echo "ClientAliveCountMax 3" >> /etc/ssh/sshd_config

# Copy tmux config
COPY --chown=opencode:opencode tmux.conf /home/opencode/.tmux.conf

# Copy bash config
COPY --chown=opencode:opencode bashrc /home/opencode/.bashrc
COPY --chown=opencode:opencode bash_profile /home/opencode/.bash_profile

# Copy entrypoint scripts
COPY entrypoint.sh /entrypoint.sh
COPY shell-entrypoint.sh /bin/shell-entrypoint
RUN chmod +x /entrypoint.sh /bin/shell-entrypoint

WORKDIR /workspace

EXPOSE 8888 2222

# Do NOT set USER opencode — entrypoint runs as root for sshd/volume init,
# then drops to opencode via su for Pi/tmux.
ENV HOME=/home/opencode
ENV BUN_INSTALL=/home/opencode/.bun
ENV PATH="/home/opencode/.local/bin:/home/opencode/.bun/bin:/home/opencode/.npm-global/bin:/nix/var/nix/profiles/default/bin:$PATH"
ENV BASH_ENV=/home/opencode/.bashrc

ENTRYPOINT ["/entrypoint.sh"]
